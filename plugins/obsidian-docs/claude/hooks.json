{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/claude/reglas_sesion.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/claude/reglas_sesion.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/claude/reglas_sesion.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks-opcionales/verificar_cierre.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-opcionales/verificar_cierre.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks-opcionales/verificar_cierre.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
